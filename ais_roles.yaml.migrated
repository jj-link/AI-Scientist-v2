# Role-based routing for self-hosted OpenAI-compatible endpoints.
#
# Every AI-Scientist role resolves its endpoint and model from this file.
# Referencing a role from any model argument uses the prefix: role/<name>
# (e.g. bfts_config.yaml: agent.code.model: role/experiment_code).
# Existing model strings (cborg/..., spark/..., ollama/..., gpt/o1/claude/gemini)
# keep working unchanged; this file only ADDS routing.
#
# Endpoints are peers: no global priority, no silent fallback.
# Credentials come from environment variables only and are never logged.

endpoints:
  local:
    # SGLang/vLLM on this workstation (RTX PRO 6000), OpenAI-compatible.
    base_url: http://localhost:8000/v1
    api_key_env: LOCAL_MODEL_API_KEY   # optional for keyless servers
    provides: [text, function_calling, vision]
    # The local server rejects a system-only conversation with no user turn.
    requires_user_message: true

  spark:
    label: Spark cluster
    # DGX Spark cluster (spark2-ts + spark3-ts), served through spark2-ts.
    base_url: http://100.92.139.82:8888/v1
    api_key_env: SPARK_MODEL_API_KEY   # optional for keyless servers
    provides: [text, vision, function_calling]
  codex:
    label: Codex (ChatGPT)
    provider: openai-codex
    provides: [text, vision, function_calling]
roles:  # Selected by the default pipeline. Custom callers may reference role/<name>.
  # ---- High-intelligence / nuanced work: Spark model by default ----

  ideation:               # research ideation (also used by reflection rounds)
    endpoint: codex
    model: gpt-6-astra
  experiment_code:        # code generation + debugging (agent.code)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 12000
    requires: [function_calling]
  experiment_feedback:    # result/traceback evaluation (agent.feedback)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 8192

  tree_scoring:           # tree-search node selection + scoring (select_node)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 4096
    requires: [function_calling]
  findings_synthesis:     # summarizing scientific findings (summary)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 8192

  visual_feedback:        # interpreting plots/figures during search (vlm_feedback)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 4096
    requires: [vision]
  writeup:                # main paper writeup + reflection (model_writeup)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 16384

  review:                 # paper review + meta-review (model_review)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 8192

  # ---- Routine / high-volume work: local model by default ----

  plot_generation:        # generating aggregation/plotting code (model_agg_plots)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 8192

  citation:               # citation lookup + formatting (model_citation)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
    max_tokens: 4096

  writeup_small:          # smaller writeup revisions (model_writeup_small)
    endpoint: spark
    model: GLM-5.3-Flash-EXL3
experiment_execution:
  cuda_device: 0
